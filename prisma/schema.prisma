```prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum SchoolStatus {
  ACTIVE
  ARCHIVED
}

enum SchoolType {
  PRIMARY
  SECONDARY
  PREPARATORY
  COMBINED
  SPECIAL
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  PART_TIME
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RETIRED
  TERMINATED
  RESIGNED
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  EXCUSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransferType {
  VOLUNTARY
  ADMINISTRATIVE
  PROMOTION
  REPLACEMENT
  EMERGENCY
  OTHER
}

enum TransferStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum SupervisionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FollowUpStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum ScopeType {
  CITY
  DISTRICT
  SCHOOL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  APPROVE
  REJECT
  COMPLETE
  ROLE_CHANGE
  PERMISSION_CHANGE
}

enum AuditResult {
  SUCCESS
  FAILURE
}

// ============================================================
// ORGANIZATION
// ============================================================

model City {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @unique
  status        OrganizationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  districts     District[]
  scopes        Scope[]
  announcements Announcement[]

  @@index([status])
}

model District {
  id        String             @id @default(uuid()) @db.Uuid
  cityId    String             @db.Uuid
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  city      City               @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  schools   School[]
  scopes    Scope[]

  @@unique([cityId, name])
  @@index([cityId])
  @@index([cityId, status])
}

model School {
  id                   String           @id @default(uuid()) @db.Uuid
  code                 String           @unique
  name                 String
  type                 SchoolType
  districtId           String           @db.Uuid
  location             String?
  address              String?
  principalId          String?          @db.Uuid
  phone                String?
  email                String?
  capacity             Int?
  status               SchoolStatus     @default(ACTIVE)
  establishedOn        DateTime?        @db.Date
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  district             District         @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  principal            Employee?       @relation("SchoolPrincipal", fields: [principalId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  teacherAssignments   TeacherAssignment[]
  studentEnrollments   StudentEnrollment[]
  transferRequestsFrom TransferRequest[] @relation("TransferFromSchool")
  transferRequestsTo   TransferRequest[] @relation("TransferToSchool")
  supervisionVisits    SupervisionVisit[]
  scopes               Scope[]

  @@index([districtId])
  @@index([districtId, status])
  @@index([type, status])
  @@index([status])
}

// ============================================================
// ACADEMIC YEAR
// ============================================================

model AcademicYear {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String              @unique
  startsOn            DateTime            @db.Date
  endsOn              DateTime            @db.Date
  isActive            Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  enrollments         StudentEnrollment[]
  teacherAssignments  TeacherAssignment[]
  attendance          Attendance[]
  leaveRequests       LeaveRequest[]
  appraisals          Appraisal[]
  disciplinaryActions DisciplinaryAction[]
  employmentHistory   EmploymentHistory[]
  transferRequests    TransferRequest[]
  supervisionVisits   SupervisionVisit[]

  @@index([isActive])
  @@index([startsOn, endsOn])
}

// ============================================================
// PERSON
// ============================================================

model Person {
  id          String    @id @default(uuid()) @db.Uuid
  fullName    String
  gender      Gender?
  dateOfBirth DateTime? @db.Date
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee    Employee?
  student     Student?
  user        User?

  @@index([fullName])
  @@index([phone])
  @@index([email])
}

// ============================================================
// EMPLOYEE
// ============================================================

model Employee {
  id                  String           @id @default(uuid()) @db.Uuid
  personId            String           @unique @db.Uuid
  employeeCode        String           @unique
  employmentStatus    EmploymentStatus @default(ACTIVE)
  employmentDate      DateTime?        @db.Date
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  person              Person            @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  teacher             Teacher?
  staff               Staff?

  employmentHistory   EmploymentHistory[]
  attendance          Attendance[]
  leaveRequests       LeaveRequest[]
  appraisals          Appraisal[]
  disciplinaryActions DisciplinaryAction[]

  principalOfSchools  School[]          @relation("SchoolPrincipal")
  supervisionVisits   SupervisionVisit[]
  followUpsAssigned   FollowUp[]        @relation("FollowUpAssignedTo")

  @@index([employmentStatus])
}

// ============================================================
// TEACHER
// ============================================================

model Teacher {
  id               String             @id @default(uuid()) @db.Uuid
  employeeId       String             @unique @db.Uuid
  qualification    String?
  specialization   String?
  employmentType   EmploymentType?
  position         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignments      TeacherAssignment[]
  transferRequests TransferRequest[]

  @@index([qualification])
  @@index([specialization])
}

// ============================================================
// STAFF
// ============================================================

model Staff {
  id             String         @id @default(uuid()) @db.Uuid
  employeeId     String         @unique @db.Uuid
  position       String?
  department     String?
  employmentType EmploymentType?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([department])
  @@index([position])
}

// ============================================================
// STUDENT
// ============================================================

model Student {
  id          String              @id @default(uuid()) @db.Uuid
  personId    String              @unique @db.Uuid
  studentCode String              @unique
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  person      Person              @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments StudentEnrollment[]

  @@index([studentCode])
}

// ============================================================
// EMPLOYMENT HISTORY
// ============================================================

model EmploymentHistory {
  id             String             @id @default(uuid()) @db.Uuid
  employeeId     String             @db.Uuid
  academicYearId String?            @db.Uuid
  employmentType EmploymentType?
  position       String?
  department     String?
  salary         Decimal?           @db.Decimal(12, 2)
  status         EmploymentStatus
  startDate      DateTime           @db.Date
  endDate        DateTime?          @db.Date
  reason         String?
  createdAt      DateTime           @default(now())

  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear?      @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId])
  @@index([employeeId, startDate])
  @@index([academicYearId])
}

// ============================================================
// TEACHER ASSIGNMENTS
// ============================================================

model TeacherAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  teacherId      String           @db.Uuid
  schoolId       String           @db.Uuid
  academicYearId String           @db.Uuid
  position       String?
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         AssignmentStatus @default(ACTIVE)
  version        Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  teacher        Teacher          @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([teacherId])
  @@index([teacherId, academicYearId])
  @@index([teacherId, status])
  @@index([schoolId, academicYearId, status])
  @@index([academicYearId, startDate, endDate])
}

// ============================================================
// STUDENT ENROLLMENT
// ============================================================

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @db.Uuid
  schoolId       String           @db.Uuid
  academicYearId String           @db.Uuid
  grade          String
  section        String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledOn     DateTime         @db.Date
  withdrawnOn    DateTime?        @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, status])
  @@index([academicYearId, grade])
  @@index([studentId])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @db.Uuid
  academicYearId String           @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkIn        DateTime?
  checkOut       DateTime?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([employeeId, date])
  @@index([academicYearId, date])
  @@index([employeeId, academicYearId, date])
}

// ============================================================
// LEAVE REQUEST
// ============================================================

model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  employeeId     String      @db.Uuid
  academicYearId String      @db.Uuid
  startsOn       DateTime    @db.Date
  endsOn         DateTime    @db.Date
  status         LeaveStatus @default(PENDING)
  reason         String?
  reviewedById   String?     @db.Uuid
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy     User?       @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([employeeId])
  @@index([employeeId, academicYearId])
  @@index([status])
  @@index([startsOn, endsOn])
}

// ============================================================
// APPRAISAL
// ============================================================

model Appraisal {
  id             String      @id @default(uuid()) @db.Uuid
  employeeId     String      @db.Uuid
  academicYearId String      @db.Uuid
  score          Decimal?    @db.Decimal(5, 2)
  comments       String?
  appraisedById  String?     @db.Uuid
  appraisalDate  DateTime    @db.Date
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  appraisedBy    User?       @relation("AppraisalsByUser", fields: [appraisedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([employeeId, academicYearId])
  @@index([academicYearId])
}

// ============================================================
// DISCIPLINARY ACTION
// ============================================================

model DisciplinaryAction {
  id             String       @id @default(uuid()) @db.Uuid
  employeeId     String       @db.Uuid
  academicYearId String?      @db.Uuid
  actionType     String
  date           DateTime     @db.Date
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId])
  @@index([academicYearId])
  @@index([date])
}

// ============================================================
// TRANSFER REQUEST
// ============================================================

model TransferRequest {
  id             String         @id @default(uuid()) @db.Uuid
  teacherId      String         @db.Uuid
  fromSchoolId   String         @db.Uuid
  toSchoolId     String         @db.Uuid
  academicYearId String         @db.Uuid
  transferType   TransferType
  reason         String?
  requestDate    DateTime       @db.Date
  status         TransferStatus @default(PENDING)
  version        Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fromSchool     School         @relation("TransferFromSchool", fields: [fromSchoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  toSchool       School         @relation("TransferToSchool", fields: [toSchoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  history        TransferHistory[]

  @@index([teacherId, status])
  @@index([status, createdAt])
  @@index([fromSchoolId, status])
  @@index([toSchoolId, status])
  @@index([academicYearId, status])
}

// ============================================================
// TRANSFER HISTORY
// ============================================================

model TransferHistory {
  id                String         @id @default(uuid()) @db.Uuid
  transferRequestId String         @db.Uuid
  fromStatus        TransferStatus
  toStatus          TransferStatus
  actorId           String?        @db.Uuid
  comment           String?
  createdAt         DateTime       @default(now())

  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor             User?           @relation("TransferHistoryActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([transferRequestId, createdAt])
  @@index([actorId, createdAt])
}

// ============================================================
// SUPERVISION VISIT
// ============================================================

model SupervisionVisit {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @db.Uuid
  supervisorId   String           @db.Uuid
  academicYearId String           @db.Uuid
  visitDate      DateTime         @db.Date
  overallScore   Decimal?         @db.Decimal(5, 2)
  status         SupervisionStatus @default(PLANNED)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supervisor     Employee         @relation(fields: [supervisorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  inspections    Inspection[]

  @@index([schoolId, visitDate])
  @@index([supervisorId, visitDate])
  @@index([academicYearId, visitDate])
}

// ============================================================
// INSPECTION
// ============================================================

model Inspection {
  id                 String           @id @default(uuid()) @db.Uuid
  supervisionVisitId String           @db.Uuid
  category           String
  score              Decimal?         @db.Decimal(5, 2)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  supervisionVisit   SupervisionVisit @relation(fields: [supervisionVisitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  findings           Finding[]

  @@index([supervisionVisitId])
  @@index([category])
}

// ============================================================
// FINDING
// ============================================================

model Finding {
  id             String          @id @default(uuid()) @db.Uuid
  inspectionId   String          @db.Uuid
  description    String
  severity       FindingSeverity
  status         FindingStatus   @default(OPEN)
  recommendation String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  inspection     Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  followUps      FollowUp[]

  @@index([inspectionId])
  @@index([severity, status])
}

// ============================================================
// FOLLOW UP
// ============================================================

model FollowUp {
  id            String         @id @default(uuid()) @db.Uuid
  findingId     String         @db.Uuid
  assignedToId  String?        @db.Uuid
  dueDate       DateTime?      @db.Date
  completedDate DateTime?      @db.Date
  status        FollowUpStatus @default(OPEN)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  finding       Finding        @relation(fields: [findingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedTo    Employee?      @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([findingId])
  @@index([assignedToId, status])
  @@index([dueDate, status])
}

// ============================================================
// USER
// ============================================================

model User {
  id                String             @id @default(uuid()) @db.Uuid
  personId          String?            @unique @db.Uuid
  email             String             @unique
  passwordHash      String?
  status            UserStatus         @default(ACTIVE)
  failedLoginCount  Int                @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  person            Person?            @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  roles             UserRole[]
  scopes            UserScope[]

  auditLogs         AuditLog[]         @relation("AuditActor")
  transferHistory   TransferHistory[]  @relation("TransferHistoryActor")
  reviewedLeaves    LeaveRequest[]     @relation("LeaveReviewedBy")
  appraisalsByUser  Appraisal[]        @relation("AppraisalsByUser")

  sessions          Session[]
  notifications     Notification[]
  sentMessages      Message[]          @relation("MessageSender")
  receivedMessages  Message[]          @relation("MessageRecipient")
  announcements     Announcement[]     @relation("AnnouncementCreator")

  @@index([status])
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

// ============================================================
// PERMISSION
// ============================================================

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())

  roles       RolePermission[]
}

// ============================================================
// USER ROLE
// ============================================================

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ============================================================
// ROLE PERMISSION
// ============================================================

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ============================================================
// AUTHORIZATION SCOPE
// ============================================================

model Scope {
  id         String    @id @default(uuid()) @db.Uuid
  type       ScopeType

  cityId     String?   @db.Uuid
  districtId String?   @db.Uuid
  schoolId   String?   @db.Uuid

  createdAt  DateTime  @default(now())

  city       City?     @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district   District? @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  school     School?   @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  users      UserScope[]

  @@index([type])
  @@index([cityId])
  @@index([districtId])
  @@index([schoolId])
}

// ============================================================
// USER SCOPE
// ============================================================

model UserScope {
  userId     String   @db.Uuid
  scopeId    String   @db.Uuid
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scope      Scope    @relation(fields: [scopeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, scopeId])
  @@index([scopeId])
}

// ============================================================
// SESSION
// ============================================================

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  actorId   String?     @db.Uuid
  action    AuditAction
  entity    String
  entityId  String
  result    AuditResult
  before    Json?
  after     Json?
  requestId String?
  createdAt DateTime    @default(now())

  actor     User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([requestId])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ============================================================
// ANNOUNCEMENT
// ============================================================

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  cityId      String?   @db.Uuid
  createdById String?   @db.Uuid
  title       String
  content     String
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  city        City?     @relation(fields: [cityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy   User?     @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([cityId])
  @@index([publishedAt])
}

// ============================================================
// DIRECT MESSAGE
// ============================================================

model Message {
  id          String   @id @default(uuid()) @db.Uuid
  senderId    String   @db.Uuid
  recipientId String   @db.Uuid
  subject     String?
  content     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([senderId, createdAt])
  @@index([recipientId, readAt])
}
