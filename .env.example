# PostgreSQL connection string used by Prisma and the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional: password used by the demo-user seed (defaults to a dev-only value).
# Always set an explicit value for shared or production environments.
SEED_DEMO_PASSWORD=""

# Optional: set to "true" to enable the /preview design-demo route
# (development only — keep disabled in production).
ENABLE_UI_PREVIEW="false"
